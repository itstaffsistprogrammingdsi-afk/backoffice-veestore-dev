APP_NAME="ImmoStore Backoffice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ASSET_URL=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ==================================================
# LOGGING
# ==================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==================================================
# DATABASE
# ==================================================
# DB utama: PostgreSQL operasional (dipakai bersama POS/WMS/e-commerce)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=veestore_dev1
DB_USERNAME=vee_user
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# DB backoffice: role, permission, audit, export, analytics
IMS_BO_DB_HOST=127.0.0.1
IMS_BO_DB_PORT=5432
IMS_BO_DB_DATABASE=veestore_bo_dev
IMS_BO_DB_USERNAME=vee_user
IMS_BO_DB_PASSWORD=
IMS_BO_DB_SCHEMA=public
IMS_BO_DB_SSLMODE=prefer

# DB lokal POS untuk handoff kendala e-commerce
POS_DB_HOST="${DB_HOST}"
POS_DB_PORT="${DB_PORT}"
POS_DB_DATABASE=veestore_pos_dev
POS_DB_USERNAME="${DB_USERNAME}"
POS_DB_PASSWORD="${DB_PASSWORD}"
POS_DB_SCHEMA=public
POS_DB_SSLMODE=prefer

# URL aplikasi POS untuk tautan lintas aplikasi
POS_APP_URL=http://127.0.0.1:8001

# ==================================================
# BACKOFFICE
# ==================================================
# Aktifkan setelah database POS terhubung dan tabel kendala tersedia
BACKOFFICE_ECOMMERCE_REJECTION_HANDOFF_ENABLED=false

BACKOFFICE_MIN_PRICE_MARGIN_PERCENT=20
BACKOFFICE_PAYMENT_SLA_HOURS=24
BACKOFFICE_ORDER_NOTIFICATION_EMAILS=
BACKOFFICE_BRAND_LISTING_EMAILS=
STOCK_BARRIER_ALERT_EMAILS=

# EDC BCA
BACKOFFICE_EDC_BCA_CREDIT_MDR_PERCENT=2.0
BACKOFFICE_EDC_BCA_DEBIT_MDR_PERCENT=1.0
BACKOFFICE_EDC_BCA_SETTLEMENT_DAYS=1

# ==================================================
# AI ASSISTANT (VEE) - 9Router (OpenAI compatible)
# ==================================================
AI_PROVIDER=nine_router
NINE_ROUTER_URL=https://your-9router-host/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=cx/gpt-5.6-luna
NINE_ROUTER_AUTO_MODEL=cx/gpt-5.6-luna
NINE_ROUTER_AUTO_SECONDARY_MODEL=cx/gpt-5.6-sol
NINE_ROUTER_AUTO_FALLBACK_MODEL=ocg/deepseek-v4.1-flash
NINE_ROUTER_AUTO_FALLBACK_SECONDARY_MODEL=ocg/glm-5.3-flash
NINE_ROUTER_EXPERT_MODEL=cx/gpt-6.1-sol
NINE_ROUTER_EXPERT_FALLBACK_MODEL=ocg/claude-haiku-5-5
AI_ASSISTANT_MODE=auto

# Token untuk MCP client (Authorization: Bearer ...)
MCP_TOKEN=

# ==================================================
# VOUCHER
# ==================================================
VOUCHER_IMAGE_DISK=public
VOUCHER_IMAGE_DIRECTORY=voucher-images
VOUCHER_IMAGE_MAX_KB=5120
VOUCHER_OCR_ENABLED=true
# Kosongkan agar mengikuti AI_PROVIDER / NINE_ROUTER_MODEL
VOUCHER_OCR_PROVIDER=
VOUCHER_OCR_MODEL=
VOUCHER_OCR_TIMEOUT=90

# ==================================================
# CACHE / QUEUE / FILES / SESSION
# ==================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1"

# Export laporan: lokal memakai sync agar tidak perlu queue worker.
# Produksi: REPORT_EXPORT_QUEUE_CONNECTION=report_exports
REPORT_EXPORT_QUEUE_CONNECTION=sync
REPORT_EXPORT_QUEUE_DB_CONNECTION=immostore_backoffice
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_DB_CONNECTION=immostore_backoffice
PERMISSION_DB_CONNECTION=immostore_backoffice

# ==================================================
# REDIS / MEMCACHED (opsional)
# ==================================================
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==================================================
# MAIL
# ==================================================
# Lokal: email dicatat ke storage/logs/laravel.log.
# Ganti MAIL_MAILER=smtp dan isi kredensial untuk pengiriman nyata.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@immostore.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==================================================
# STORAGE / AWS (opsional)
# ==================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==================================================
# PUSHER (opsional)
# ==================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ==================================================
# INTEGRASI Doku & Biteship
# ==================================================
DOKU_ENABLED=false
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_WEBHOOK_URL=
DOKU_DOCS_URL=https://developers.doku.com

BITESHIP_ENABLED=false
BITESHIP_ENVIRONMENT=sandbox
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_URL=
BITESHIP_DOCS_URL=https://biteship.com/id/docs

# ==================================================
# VITE
# ==================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
