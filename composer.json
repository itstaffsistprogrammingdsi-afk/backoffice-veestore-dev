{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.8",
    "inertiajs/inertia-laravel": "^3.6",
    "laravel/ai": "^1.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^3.0",
    "maatwebsite/excel": "^3.1.70",
    "ramsey/uuid": "^4.9",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "spatie/laravel-permission": "^6.25"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^12.0",
    "spatie/laravel-ignition": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "lint": "pint --test app/Ai app/Domain app/Http/Controllers/AIAnalytics app/Http/Controllers/MasterData/BrandController.php app/Http/Controllers/ReportExportController.php app/Http/Kernel.php app/Http/Middleware/HandleInertiaRequests.php app/Http/Middleware/VerifyCsrfToken.php app/Http/Requests app/Jobs/GenerateReportExport.php app/Providers/AuthServiceProvider.php app/Providers/RouteServiceProvider.php app/Services/ReportExportService.php config/ai.php config/queue.php config/sanctum.php database/migrations/2026_09_15_100000_create_report_exports.php database/migrations/2026_10_03_170000_create_failed_jobs_table.php routes/web.php tests/Concerns tests/Feature/AIAnalytics tests/Feature/MasterData tests/Feature/QueuedReportExportTest.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.26"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
