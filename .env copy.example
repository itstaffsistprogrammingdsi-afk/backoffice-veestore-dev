APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Laravel AI SDK — 9Router (OpenAI compatible)
AI_PROVIDER=nine_router
NINE_ROUTER_URL=https://your-9router-host/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=cx/gpt-5.6-luna
NINE_ROUTER_AUTO_MODEL=cx/gpt-5.6-luna
NINE_ROUTER_AUTO_SECONDARY_MODEL=cx/gpt-5.6-sol
NINE_ROUTER_AUTO_FALLBACK_MODEL=ocg/deepseek-v4.1-flash
NINE_ROUTER_AUTO_FALLBACK_SECONDARY_MODEL=ocg/glm-5.3-flash
NINE_ROUTER_EXPERT_MODEL=cx/gpt-6.1-sol
NINE_ROUTER_EXPERT_FALLBACK_MODEL=ocg/claude-haiku-5-5
AI_ASSISTANT_MODE=auto

# Token untuk MCP client (Authorization: Bearer ...)
MCP_TOKEN=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VOUCHER_IMAGE_DISK=public
VOUCHER_IMAGE_DIRECTORY=voucher-images
VOUCHER_IMAGE_MAX_KB=5120
VOUCHER_OCR_ENABLED=true
VOUCHER_OCR_PROVIDER=
VOUCHER_OCR_MODEL=
VOUCHER_OCR_TIMEOUT=90

BACKOFFICE_ORDER_NOTIFICATION_EMAILS=

BACKOFFICE_MIN_PRICE_MARGIN_PERCENT=20

BACKOFFICE_BRAND_LISTING_EMAILS=

BACKOFFICE_PAYMENT_SLA_HOURS=24

# EDC BCA
BACKOFFICE_EDC_BCA_CREDIT_MDR_PERCENT=2.0
BACKOFFICE_EDC_BCA_DEBIT_MDR_PERCENT=1.0
BACKOFFICE_EDC_BCA_SETTLEMENT_DAYS=1

# Integrasi Doku
DOKU_ENABLED=false
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_WEBHOOK_URL=
DOKU_DOCS_URL=https://developers.doku.com

# Integrasi Biteship
BITESHIP_ENABLED=false
BITESHIP_ENVIRONMENT=sandbox
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_URL=
BITESHIP_DOCS_URL=https://biteship.com/id/docs
